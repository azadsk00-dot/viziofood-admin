# Kitchen tablet environment — copy to .env (never commit real values).
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.
# Only public values belong here: the anon key is safe (RLS is the real
# authorization layer); NEVER put the service-role key or Stripe secrets
# in this app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: override if Edge Functions live elsewhere (rare).
# EXPO_PUBLIC_SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT.supabase.co/functions/v1

# Optional: LAN printer agent (printer-service with VIZIO_AGENT_HTTP_PORT set).
# Find the IP of the PC running the printer service on the restaurant LAN.
EXPO_PUBLIC_PRINTER_AGENT_URL=http://192.168.1.20:3777
EXPO_PUBLIC_PRINTER_AGENT_TOKEN=

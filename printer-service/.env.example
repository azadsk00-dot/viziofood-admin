# Vizio printer service — copy to .env and fill in.

# Supabase project (same values as the website's .env.local)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# A dedicated staff/kitchen account (create it in Supabase Auth, then set
# its profiles.role to 'kitchen' or 'staff'). Use a strong password; this
# account can read orders — do not reuse a personal account.
VIZIO_EMAIL=kitchen@viziofood.com
VIZIO_PASSWORD=strong-password-here

# Optional: only serve one station ('kitchen', 'coffee', …). Blank = all.
VIZIO_STATION=

# Optional: header name on tickets.
VIZIO_RESTAURANT_NAME=VIZIO FOOD

# Defaults for `npm run test-print`
VIZIO_TEST_HOST=192.168.1.50
VIZIO_TEST_PORT=9100

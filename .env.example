# Vizio Food web app — copy to .env.local (dev) or set at build time (deploy).
# Public values only. Stripe secrets and service-role keys live exclusively
# in the Edge Function secrets — NEVER in the frontend.

# Supabase project (required).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Edge Function endpoints (optional — each defaults to
# ${VITE_SUPABASE_URL}/functions/v1/<name> when unset).
VITE_STRIPE_CHECKOUT_ENDPOINT=
VITE_REFUND_ENDPOINT=
VITE_CHECKOUT_VERIFY_ENDPOINT=

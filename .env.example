# ── Vizio Food platform — environment template ─────────────────────────────
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase project (find at: Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Edge Function endpoints (normally just YOUR-PROJECT/functions/v1/…)
VITE_STRIPE_CHECKOUT_ENDPOINT=https://YOUR-PROJECT.supabase.co/functions/v1/create-checkout
VITE_REFUND_ENDPOINT=https://YOUR-PROJECT.supabase.co/functions/v1/process-refund
VITE_CHECKOUT_VERIFY_ENDPOINT=https://YOUR-PROJECT.supabase.co/functions/v1/verify-checkout-session

# ── Edge Function secrets (set with `supabase secrets set`, NEVER here) ────
# STRIPE_SECRET_KEY=sk_live_…            (create-checkout, verify, refund, webhook)
# STRIPE_WEBHOOK_SECRET=whsec_…          (stripe-webhook only)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role (server-side only — never in the browser)
# SUPABASE_ACCESS_TOKEN=…                (push-notifications token store, optional)

# ── Local printer service (printer-service/) ───────────────────────────────
# See printer-service/README.md — configured via its own .env, not this file.

# VIZIO FOOD Orders environment — copy to .env (never commit real values).
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.
# Only public values belong here: the anon key is safe (RLS is the real
# authorization layer); NEVER put the service-role key or Stripe secrets
# in this app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
